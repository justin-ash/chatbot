APP_NAME="ChatMingle"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bot.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telegrambot
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram Bot & Stars Billing Configuration
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
TELEGRAM_WEBHOOK_URL="${APP_URL}/api/telegram/webhook"
TELEGRAM_ADMIN_IDS=123456789,987654321
TELEGRAM_QUEUE_UPDATES=true

# Quota & Stars Pack Settings (XTR integer Stars amount, ~USD $2 equivalent target)
FREE_MATCHES_PER_DAY=10
PAID_PACK_CREDITS=50
PAID_PACK_STARS=100
CUSTOM_PAYMENT_URL=
USAGE_TIMEZONE=UTC

# Abuse & Retention Controls
MESSAGE_RATE_LIMIT_PER_MINUTE=25
SEARCH_COOLDOWN_SECONDS=3
QUEUE_TIMEOUT_MINUTES=30
MESSAGE_MAX_LENGTH=2000
RETENTION_DAYS_METADATA=30

# Legal & Policy URLs
TERMS_URL=https://bot.example.com/terms
PRIVACY_URL=https://bot.example.com/privacy
SUPPORT_CONTACT=@YourSupportHandle
MINIMUM_AGE=18
